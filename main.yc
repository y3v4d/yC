i32* bump_pointer = &__heap_base;
char* malloc(i32 n) {
    i32* r = bump_pointer;
    bump_pointer = bump_pointer + n;

    return r;
}

void main() {
    char* test = malloc(10);
    i32* testi = malloc(2 * sizeof(i32));
    char* test2 = malloc(4);

    testi[0] = 5;
    testi[1] = 10;

    test2[0] = 'H';
    test2[1] = 'e';
    test2[2] = 'y';
    test2[3] = '!';
    test2[4] = 0;

    print sizeof(*test);

    print test;
    print testi;
    print *testi;
    print *(testi + 4);
    print testi[1];
    puts(test2);
}
